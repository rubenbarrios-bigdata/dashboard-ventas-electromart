	partition 'Ventas Supermercado' = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents("C:\Users\ismar\Downloads\dashboard_ventas_electromart\ventas_electromart.xlsx"), null, true),
				    #"Ventas Supermercado_Sheet" = Origen{[Item="Ventas Supermercado",Kind="Sheet"]}[Data],
				    #"Encabezados Promovidos" = Table.PromoteHeaders(#"Ventas Supermercado_Sheet", [PromoteAllScalars=true]),
				    #"Tipo Cambiado" = Table.TransformColumnTypes(#"Encabezados Promovidos",{
				        {"Número Venta", Int64.Type}, {"ID Venta", type text},
				        {"Mes Salida", Int64.Type}, {"Dia Salida", Int64.Type}, {"Año Salida", Int64.Type}, {"Fecha Salida", type date}, {"Dia Semana Salida", Int64.Type},
				        {"Mes Entrega", Int64.Type}, {"Dia Entrega", Int64.Type}, {"Año Entrega", Int64.Type}, {"Fecha Entrega", type date}, {"Dia Semana Entrega", Int64.Type},
				        {"Días para entrega", Int64.Type}, {"Dias Laborables para Entrega", Int64.Type},
				        {"Método Envio", type text}, {"ID Cliente", type text}, {"Número Cliente", Int64.Type}, {"Nombre Cliente", type text},
				        {"Segmento", type text}, {"Ciudad", type text}, {"Estado", type text}, {"País", type text},
				        {"Mercado", type text}, {"Región", type text},
				        {"ID Producto", type text}, {"Categoría", type text}, {"Sub-Categoría", type text}, {"Nombre Producto", type text},
				        {"Ventas", type number}, {"Cantidad", Int64.Type}, {"Descuento", type number}, {"Utilidad", type number},
				        {"Resultado Venta", type text}, {"Costo Envío", type number}, {"Prioridad Envio", type text}, {"Efectividad Prioridad", type text}
				    }),
				    #"Mes Nombre Agregado" = Table.AddColumn(#"Tipo Cambiado", "Mes Nombre", each
				        let m = [Mes Salida] in
				        if m = 1 then "Ene" else if m = 2 then "Feb" else if m = 3 then "Mar" else if m = 4 then "Abr"
				        else if m = 5 then "May" else if m = 6 then "Jun" else if m = 7 then "Jul" else if m = 8 then "Ago"
				        else if m = 9 then "Sep" else if m = 10 then "Oct" else if m = 11 then "Nov" else "Dic", type text),
				    #"Día Semana Nombre Agregado" = Table.AddColumn(#"Mes Nombre Agregado", "Día Semana Nombre", each
				        let d = [Dia Semana Salida] in
				        if d = 1 then "Lun" else if d = 2 then "Mar" else if d = 3 then "Mié" else if d = 4 then "Jue"
				        else if d = 5 then "Vie" else if d = 6 then "Sáb" else "Dom", type text)
				in
				    #"Día Semana Nombre Agregado"

	annotation PBI_ResultType = Table

