table Calendario
	lineageTag: a3b5e1ca-e182-473b-bd59-544f6cfd035d
	dataCategory: Time

	column Fecha
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 44d75382-43a5-45b8-8b4d-9d8195fa093c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fecha]

		annotation UnderlyingDateTimeDataType = Date

	column Año
		dataType: int64
		formatString: 0
		lineageTag: 31a8a778-b7cf-4632-a5d1-663943ea14eb
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column 'Mes Num'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b5eeffd2-3f6b-4bc7-b8e0-7cdfbac96a70
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Mes Num]

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: string
		lineageTag: 86754b07-ba34-4139-ac24-7adfeb7ca830
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes]
		sortByColumn: 'Mes Num'

	column Trimestre
		dataType: string
		lineageTag: b44bc6f5-002e-49cd-8761-db70ca0dfa13
		summarizeBy: none
		isNameInferred
		sourceColumn: [Trimestre]

	column 'Año Mes Num'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a18db713-57d0-49c1-94cc-4f9d9510e9ec
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Año Mes Num]

		annotation SummarizationSetBy = Automatic

	column 'Mes Año'
		dataType: string
		lineageTag: 601eeae7-b87c-4d6d-95c2-65e2fe964281
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes Año]
		sortByColumn: 'Año Mes Num'

	column 'Día Semana Num'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ac60654d-554c-48bd-a736-089a39203dc3
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Día Semana Num]

		annotation SummarizationSetBy = Automatic

	column 'Día Semana'
		dataType: string
		lineageTag: 1836e731-ede2-4578-b6d5-b780f9e52c85
		summarizeBy: none
		isNameInferred
		sourceColumn: [Día Semana]
		sortByColumn: 'Día Semana Num'

	partition Calendario = calculated
		mode: import
		source =
				VAR _ini = DATE ( 2011, 1, 1 )
				VAR _fin = DATE ( 2014, 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        SELECTCOLUMNS ( CALENDAR ( _ini, _fin ), "Fecha", [Date] ),
				        "Año", YEAR ( [Fecha] ),
				        "Mes Num", MONTH ( [Fecha] ),
				        "Mes", SWITCH ( MONTH ( [Fecha] ), 1, "Ene", 2, "Feb", 3, "Mar", 4, "Abr", 5, "May", 6, "Jun", 7, "Jul", 8, "Ago", 9, "Sep", 10, "Oct", 11, "Nov", 12, "Dic" ),
				        "Trimestre", "T" & QUARTER ( [Fecha] ),
				        "Año Mes Num", YEAR ( [Fecha] ) * 100 + MONTH ( [Fecha] ),
				        "Mes Año", SWITCH ( MONTH ( [Fecha] ), 1, "Ene", 2, "Feb", 3, "Mar", 4, "Abr", 5, "May", 6, "Jun", 7, "Jul", 8, "Ago", 9, "Sep", 10, "Oct", 11, "Nov", 12, "Dic" ) & " " & YEAR ( [Fecha] ),
				        "Día Semana Num", WEEKDAY ( [Fecha], 2 ),
				        "Día Semana", SWITCH ( WEEKDAY ( [Fecha], 2 ), 1, "Lun", 2, "Mar", 3, "Mié", 4, "Jue", 5, "Vie", 6, "Sáb", 7, "Dom" )
				    )

